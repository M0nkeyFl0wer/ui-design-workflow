# Dependencies
node_modules/
package-lock.json
yarn.lock

# Environment files
.env
.env.local
.env.development
.env.production
.env.test

# Screenshots (keep structure, ignore content)
screenshots/current/*
screenshots/archive/*
!screenshots/current/.gitkeep
!screenshots/archive/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-*

# Build outputs
dist/
build/
out/

# Test coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
.tmp/

# Cache
.cache/
.npm/
.yarn/

# Python (for scripts)
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/

# Backup files
*.backup
*.bak

# SSH keys (never commit these)
*.pem
*.key
id_rsa*
id_ed25519*

# Browser data
.chromium-data/
.firefox-data/